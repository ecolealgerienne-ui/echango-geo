# ── echango-geo — stack de production (VPS) ─────────────────────────────────
# Copier en .env.production et renseigner. Un seul fichier, à la fois
# --env-file (substitution ${...} du compose) et env_file du service geo-api.

# Jeton partagé exigé de chaque backend appelant (X-Internal-Token).
# Générer : openssl rand -hex 32
GEO_INTERNAL_TOKEN=

# Nombre de proxys devant geo-api. Vide en v1 : pas de Traefik (§7.1).
TRUST_PROXY=

# Extraits Geofabrik réellement importés dans Nominatim (§6.3). Laisser `dz`
# tant que l'extrait AE fusionné n'est pas monté (voir docker-compose.yml).
GEO_DEFAULT_COUNTRIES=dz
GEO_SUPPORTED_COUNTRIES=dz

# Adressage interne — le nom de service, pas « nominatim » ni « postgres ».
NOMINATIM_INTERNAL_URL=http://geo-nominatim:8080

GEO_RATE_LIMIT_PER_IP=20
GEO_HTTP_TIMEOUT_MS=10000

# Mot de passe du Postgres interne à l'image Nominatim (distinct de toute base
# applicative — aucun partage, §6.1).
NOMINATIM_DB_PASSWORD=
