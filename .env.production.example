# ── echango-geo — stack de production VPS (docker-compose.prod.yml) ─────────
# Copier en .env.production, renseigner, ne JAMAIS commiter (gitignoré).
# Un seul fichier : lu par `docker compose --env-file` (substitution ${...}
# pour NOMINATIM_DB_PASSWORD) ET injecté dans geo-api (env_file).
# Procédure complète : docs/DEPLOIEMENT_VPS.md

# Jeton partagé exigé dans l'en-tête X-Internal-Token de chaque backend
# appelant. DOIT être identique dans les .env.production d'echango-delivery
# et d'echangopromo. Générer : openssl rand -hex 32
GEO_INTERNAL_TOKEN=

# Nombre de proxys HTTP devant geo-api. Vide : pas de Traefik ni de proxy
# devant ce service (§7.1) — `req.ip` est alors l'adresse de la socket, ce
# qui est juste pour le rate-limit par IP appelante.
TRUST_PROXY=

# Extraits Geofabrik réellement importés dans Nominatim (§6.3). `dz` seul —
# les Émirats sont écartés (§10). Une requête `country=ae` est refusée en
# geo.country_not_configured, franchement.
GEO_DEFAULT_COUNTRIES=dz
GEO_SUPPORTED_COUNTRIES=dz

# Adressage interne de Nominatim — le nom de service, jamais « nominatim »
# ni « postgres » (collision DNS sur echango_network, incident réel côté promo).
NOMINATIM_INTERNAL_URL=http://geo-nominatim:8080

# Protection contre une boucle cliente (pas contre notre propre instance) :
# requêtes/s autorisées par IP appelante.
GEO_RATE_LIMIT_PER_IP=20
# Délai avant geo.upstream_unavailable (503).
GEO_HTTP_TIMEOUT_MS=10000

# Mot de passe du Postgres interne à l'image Nominatim (distinct de toute base
# applicative — aucun partage, §6.1). Alphanumérique de préférence.
NOMINATIM_DB_PASSWORD=
