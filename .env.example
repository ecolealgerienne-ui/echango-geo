# ── echango-geo — stack LOCALE (docker-compose.yml) ────────────────────────
# Copier en .env. Valeurs de dev : à ne jamais utiliser en prod (voir
# .env.production.example pour le VPS).

# Jeton exigé dans X-Internal-Token sur toutes les routes /v1/*. En local, une
# valeur quelconque suffit — c'est aussi celle à passer aux bancs :
#   GEO_INTERNAL_TOKEN=dev-local-token ./scripts/test-geocode-search.sh
GEO_INTERNAL_TOKEN=dev-local-token

# La stack locale n'importe que l'extrait DZ : garder la liste à `dz` pour que
# `country=ae` échoue franchement au lieu de chercher dans le vide.
GEO_DEFAULT_COUNTRIES=dz
GEO_SUPPORTED_COUNTRIES=dz

GEO_RATE_LIMIT_PER_IP=20
GEO_HTTP_TIMEOUT_MS=10000

# Ports publiés sur l'hôte par docker-compose.yml (dé-commenter pour changer).
# GEO_API_HOST_PORT=3000
# NOMINATIM_HOST_PORT=8088

# Mot de passe du Postgres interne à l'image Nominatim.
NOMINATIM_DB_PASSWORD=nominatim
