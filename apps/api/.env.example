# ── echango-geo / apps/api — configuration (§6.3 des specs) ──────────────────
# Tout est optionnel SAUF GEO_INTERNAL_TOKEN : sans lui le service démarre mais
# refuse toute requête (fail-closed).

# Port d'écoute HTTP (interne au réseau Docker, non publié sur l'hôte).
PORT=3000

# Nombre de proxys entre Internet et ce process. Vide = 0 (aucun proxy, le cas
# en v1 : pas de Traefik devant ce service). Jamais « true ».
# TRUST_PROXY=

# Jeton partagé attendu dans l'en-tête X-Internal-Token de chaque appelant.
# À générer : openssl rand -hex 32
GEO_INTERNAL_TOKEN=

# Pays utilisés quand la requête ne précise pas ?country= . Codes ISO-2
# minuscules, séparés par des virgules.
GEO_DEFAULT_COUNTRIES=dz

# Liste FERMÉE des extraits Geofabrik réellement importés dans Nominatim.
# Une requête country=fr hors de cette liste est refusée en
# geo.country_not_configured, pas cherchée dans le vide.
GEO_SUPPORTED_COUNTRIES=dz,ae

# URL du conteneur Nominatim sur le réseau Docker interne.
NOMINATIM_INTERNAL_URL=http://geo-nominatim:8080

# Requêtes par seconde autorisées par IP appelante.
GEO_RATE_LIMIT_PER_IP=20

# Délai (ms) avant geo.upstream_unavailable.
GEO_HTTP_TIMEOUT_MS=10000
